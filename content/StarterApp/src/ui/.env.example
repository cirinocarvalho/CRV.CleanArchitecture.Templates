# Copy this file to .env.local (your machine) or .env.dev / .env.prod (builds)
# and fill in real values. Anything committed here must be a placeholder.
#
# NOTE: VITE_* values are baked into the browser bundle at build time. Never put
# a real secret in one — treat them as public configuration.

NODE_ENV=development
VITE_APP_ENVIRONMENT=development

# Base path the app is served from ("" for the site root).
VITE_BASE_URL=

# Where the SPA sends API calls. In local dev this stays "/api" so requests go
# through the Vite proxy defined in vite.config.ts; for built environments set
# it to the full API origin, e.g. https://api.example.com
VITE_API_URL=/api

# Local dev only: the API the Vite proxy forwards /api to.
VITE_DEV_API_PROXY=https://localhost:7170

# Google Analytics — leave empty to disable analytics entirely.
VITE_APP_GA_MEASUREMENT_ID=

# The build's version, set by the deploy workflow from the release tag — leave it empty
# here. The help center prints it at the foot of every topic, so support can ask which
# build someone is on; without it the pages read "local build".
VITE_APP_VERSION=
