<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Handle History Mode and custom 404/500" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <!-- Rewrite to the index.html FILE (not the /starterapp directory).
               Rewriting to a directory makes IIS 301-redirect to add a trailing
               slash, which drops the deep path and sends every refresh to Home. -->
          <action type="Rewrite" url="/starterapp/index.html" />
        </rule>
      </rules>
      <!-- Append HttpOnly + Secure to any Set-Cookie this app emits. The SPA
           itself sets no cookies (the JWT lives in sessionStorage - see
           services/auth.ts), so this exists to cover infrastructure cookies
           (ARR affinity, WAF) and to satisfy scanner findings.
           SAFE ONLY BECAUSE no JavaScript here reads a cookie: HttpOnly makes a
           cookie invisible to document.cookie, so if a future feature needs a
           JS-readable cookie, exclude it by name in the preCondition below.
           Note this cannot touch cookies set by a device in front of IIS.
           SameSite=Lax, not Strict: Strict withholds cookies on cross-site
           top-level GETs, which breaks any return leg from an external redirect
           (payment gateway, SSO). Tighten to Strict if you have none. -->
      <outboundRules>
        <rule name="Add HttpOnly, Secure and SameSite to Set-Cookie" preCondition="Cookie missing flags">
          <match serverVariable="RESPONSE_Set_Cookie" pattern=".*" />
          <action type="Rewrite" value="{R:0}; HttpOnly; Secure; SameSite=Lax" />
        </rule>
        <preConditions>
          <preCondition name="Cookie missing flags">
            <add input="{RESPONSE_Set_Cookie}" pattern="." />
            <add input="{RESPONSE_Set_Cookie}" pattern="HttpOnly" negate="true" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <!-- The CORS headers that used to live here are gone on purpose. The API
             owns CORS (CorsSettings:AllowedOrigins, see Program.cs); a wildcard
             Access-Control-Allow-Origin served from the SPA host let any site
             read these responses. -->
        <remove name="Cache-Control" />
        <remove name="X-Powered-By" />
        <remove name="Pragma" />
        <remove name="Expires" />
        <!-- Default for the SPA shell (index.html): never cache, so a deploy is
             picked up immediately. Hashed files under /assets override this in
             the <location> block below. -->
        <add name="Cache-Control" value="no-cache, no-store" />
        <add name="Pragma" value="no-cache" />
        <add name="Expires" value="0" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Permitted-Cross-Domain-Policies" value="none" />
        <!-- Content-Security-Policy. Every host below is required by something
             the scaffolded app actually loads. Add yours as you add integrations,
             and delete the ones you drop:
               googletagmanager       vue-gtag (only when VITE_APP_GA_MEASUREMENT_ID
                                      is set - see main.ts). Remove both Google
                                      hosts if you do not use analytics.
               *.google-analytics.com GA4 /g/collect beacons
               analytics.google.com   GA4 /g/collect on the APEX host. Listed
                                      separately on purpose: a CSP wildcard
                                      matches subdomains only, so *.analytics.
                                      google.com does NOT cover the bare host.
               *.analytics.google.com GA4 regional collect endpoint (regionN.*)
             connect-src 'self' covers the API when it is served from this origin
             (VITE_API_URL=/api). A cross-origin API needs its host added there.
             'unsafe-inline' in style-src is required by Vue's scoped-style and
             :style bindings. Do NOT add 'unsafe-inline' or 'unsafe-eval' to
             script-src, and do NOT add script-src-elem / style-src-elem: the
             -elem directives take precedence over script-src/style-src, so an
             'unsafe-inline' there silently re-enables inline scripts. -->
        <add name="Content-Security-Policy" value="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; frame-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com; worker-src 'self' blob:; form-action 'self';" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
  </system.webServer>

  <!-- Vite emits content-hashed filenames under /assets, so those responses can
       be cached forever. Without this they inherit the no-store above and the
       whole bundle is re-downloaded on every page load. -->
  <location path="assets">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <remove name="Pragma" />
          <remove name="Expires" />
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
