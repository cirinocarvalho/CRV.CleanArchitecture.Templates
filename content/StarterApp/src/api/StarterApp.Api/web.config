<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <httpProtocol>
        <customHeaders>
          <!-- IIS appends X-Powered-By after the managed pipeline returns, so
               SecurityHeadersMiddleware cannot remove it. It has to go here. -->
          <remove name="X-Powered-By" />
          <!-- SecurityHeadersMiddleware already sends X-Frame-Options: DENY on
               every response the app produces. This copy exists so that responses
               IIS generates itself (request-filtering 404s, module errors that
               never reach the app) carry it too, and so that scanners that read
               web.config (CodeQL cs/web/missing-x-frame-options) see it. When
               both fire the browser receives the same value twice, which every
               browser treats as DENY. Keep the value in sync with the middleware. -->
          <add name="X-Frame-Options" value="DENY" />
        </customHeaders>
      </httpProtocol>
      <security>
        <!-- Same reason as X-Powered-By above: the Server header is added by IIS
             after the app runs, so Headers.Remove("Server") in middleware is a
             no-op and this attribute is what actually strips it. -->
        <requestFiltering removeServerHeader="true">
          <!-- Keep this >= FileStorage:MaxBytes and the [RequestSizeLimit] on any
               upload action (50 MB by default). IIS request filtering runs BEFORE
               the ASP.NET Core module, and its default of ~28.6 MB rejects larger
               uploads with a bare 404.13 that never reaches the app - no
               ProblemDetails, no log entry. Lower it if you accept no uploads. -->
          <requestLimits maxAllowedContentLength="52428800" />
          <verbs allowUnlisted="true">
            <!-- OPTIONS stays allowed: CORS preflight needs it. -->
            <add verb="TRACE" allowed="false" />
          </verbs>
          <hiddenSegments>
            <!-- Upload storage defaults to App_Data\uploads (see Program.cs).
                 Nothing calls UseStaticFiles today, so this is defence in depth. -->
            <remove segment="App_Data" />
            <add segment="App_Data" />
          </hiddenSegments>
        </requestFiltering>
      </security>
      <!-- Preserve the app's ProblemDetails response bodies instead of letting
           IIS replace them with its own error pages. -->
      <httpErrors existingResponse="PassThrough" />
      <aspNetCore processPath="dotnet" arguments=".\StarterApp.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
