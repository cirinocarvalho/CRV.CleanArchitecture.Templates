{
  // Copy the values you need into user-secrets or environment variables.
  // Nothing in this file is read at runtime — it documents the shape of the settings.
  "ConnectionStrings": {
    //#if (useAuth)
    "IdentityConnection": "Host=<db-host>;Port=5432;Database=<db-name>;Username=<db-user>;Password=<set-via-user-secrets-or-env>;SSL Mode=Require",
    //#endif
    "AppConnection": "Host=<db-host>;Port=5432;Database=<db-name>;Username=<db-user>;Password=<set-via-user-secrets-or-env>;SSL Mode=Require"
  },
  //#if (useLocalIdentity)
  "JwtSettings": {
    "Secret": "<set-via-user-secrets-or-env-32+chars>",
    "Issuer": "StarterApp.API",
    "Audience": "StarterApp.Client",
    "ExpirationInMinutes": 720
  },
  //#endif
  //#if (useEntra)
  // From the Entra app registration exposing this API. Audience is usually
  // "api://<ClientId>"; Scopes is the scope name you exposed on it.
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<directory-tenant-id>",
    "ClientId": "<api-app-registration-client-id>",
    "Audience": "api://<api-app-registration-client-id>",
    "Scopes": "access_as_user"
  },
  //#endif
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  //#if (useLocalIdentity)
  // Optional. Omit the section entirely to use these defaults. Limits are per
  // client IP over a fixed window; see Extensions/RateLimitingExtensions.cs.
  "RateLimitSettings": {
    "WindowSeconds": 60,
    "AuthPermitLimit": 20,
    "EmailPermitLimit": 5
  },
  //#endif
  "FileStorage": {
    "RootFolder": "<absolute-path-or-empty-for-App_Data-uploads>",
    "MaxBytes": 52428800
  },
  "Email": {
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 25,
    "EnableSsl": false,
    "SmtpUser": "",
    "SmtpPassword": "<set-via-user-secrets-or-env>",
    "FromAddress": "noreply@example.com",
    "NoReplyAddress": "noreply@example.com",
    "SupportEmail": "support@example.com",
    // Notified when a new user registers and is awaiting approval. Several
    // addresses may be separated by ';' or ','. Leave empty to disable.
    "AdminNotificationEmail": "",
    "AppBaseUrl": "https://<app-host>",
    "PasswordResetPath": "/reset-password"
  }
}
