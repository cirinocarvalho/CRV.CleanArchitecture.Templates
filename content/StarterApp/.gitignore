# ─────────────────────────────────────────────
# .NET / Visual Studio build output
# ─────────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/

# ReSharper / Rider
.idea/
*.DotSettings.user
.vs/
.vscode/
# ─────────────────────────────────────────────
# Node / Vite (src/ui)
# ─────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
dist.zip
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / Playwright output
playwright-report/
test-results/

# ─────────────────────────────────────────────
# Secrets / environment
# ─────────────────────────────────────────────
# appsettings.json and appsettings.Development.json ARE tracked: they hold only
# placeholders and local defaults. Real secrets belong in user-secrets or
# environment variables, which override the files without touching them.
.env
.env.local
.env.*.local
# Per-environment builds may hold real keys — commit .env.example instead.
src/ui/.env.dev
src/ui/.env.prod
# Local HTTPS certificates for the Vite dev server.
src/ui/ssl/

# ─────────────────────────────────────────────
# Terraform
# ─────────────────────────────────────────────
# terraform.tfvars carries account IDs, VPCs and certificate ARNs — commit only
# terraform.tfvars.example. State can contain secrets even when the backend is remote.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# ─────────────────────────────────────────────
# OS / editor cruft
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────
# Stray / scratch files
# ─────────────────────────────────────────────
src/ui/output.txt
src/ui/test-bulma.scss
